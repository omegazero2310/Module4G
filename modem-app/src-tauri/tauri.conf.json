{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A7670 Modem",
  "version": "0.1.0",
  "identifier": "com.a7670.modem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-tauri-bundle.ps1 && npm run build",
    "frontendDist": "../dist"
  },
  "app": { "windows": [{ "title": "A7670 Modem", "width": 1120, "height": 760, "minWidth": 760, "minHeight": 560 }] },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "externalBin": ["binaries/modemd"],
    "resources": {
      "../../third_party/simcom/windows10-x64-serial/simfilter.inf": "drivers/simcom/simfilter.inf",
      "../../third_party/simcom/windows10-x64-serial/simlteusbfilter.cat": "drivers/simcom/simlteusbfilter.cat",
      "../../third_party/simcom/windows10-x64-serial/filter/amd64/simlteusbfilter.sys": "drivers/simcom/filter/amd64/simlteusbfilter.sys",
      "../../third_party/simcom/windows10-x64-serial/simser.inf": "drivers/simcom/simser.inf",
      "../../third_party/simcom/windows10-x64-serial/simlteusbser.cat": "drivers/simcom/simlteusbser.cat",
      "../../third_party/simcom/windows10-x64-serial/serial/amd64/simlteusbser.sys": "drivers/simcom/serial/amd64/simlteusbser.sys"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
